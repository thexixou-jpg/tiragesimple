---
import BaseLayout from './BaseLayout.astro';
interface Props { title: string; description: string; updated?: string; }
const { title, description, updated = '30 août 2026' } = Astro.props;
---
<BaseLayout title={`${title} | TirageSimple`} {description}>
  <header class="tool-hero"><div class="container tool-heading"><h1>{title}</h1><p>Dernière mise à jour : {updated}</p></div></header>
  <article class="container legal-content prose"><slot /></article>
</BaseLayout>
