---
import CopyButton from './CopyButton.astro'; import ResultCard from './ResultCard.astro';
---
<div class="tool-panel" data-letter-tool>
  <div class="field"><label for="letter-count">Quantité de lettres</label><input id="letter-count" type="number" value="1" min="1" max="1000" data-letter-count /></div>
  <div class="form-row">
    <label class="check-field option-card"><input type="checkbox" data-letter-accents /><span><strong>Inclure les accents</strong><small>Ajoute notamment É, Ç, À et Ü.</small></span></label>
    <label class="check-field option-card"><input type="checkbox" data-letter-unique /><span><strong>Sans doublons</strong><small>Chaque lettre n’apparaît qu’une fois.</small></span></label>
  </div>
  <p class="field-error" data-error role="alert" hidden></p>
  <button class="button button-primary" type="button" data-generate-letters>Générer les lettres</button>
  <ResultCard title="Lettres générées" hidden><CopyButton target="[data-letter-tool] [data-result-value]" /></ResultCard>
</div>
<script>import '../scripts/generators';</script>
