---
import { mainNavigation } from '../data/navigation';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" title="Accueil TirageSimple">
      <span class="brand-mark" aria-hidden="true">T</span>
      <span>Tirage<span>Simple</span></span>
    </a>
    <nav aria-label="Navigation principale">
      <ul class="nav-list">
        {mainNavigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li>
          <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="Activer le thème sombre" title="Changer de thème">
            <span aria-hidden="true" data-theme-icon>◐</span>
            <span class="theme-toggle-label" data-theme-label>Thème sombre</span>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>
