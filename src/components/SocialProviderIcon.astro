---
import type { SimpleIcon } from 'simple-icons';
import { siBluesky, siDiscord, siFacebook, siGithub, siGitlab, siInstagram, siKick, siLemmy, siMastodon, siMixcloud, siReddit, siSoundcloud, siStackoverflow, siTiktok, siTwitch, siVimeo, siX, siYoutube } from 'simple-icons';
import type { SocialProviderId } from '../data/social-contests';

interface Props { provider: SocialProviderId; }
const { provider } = Astro.props;
const icons: Partial<Record<SocialProviderId, SimpleIcon>> = {
  youtube:siYoutube, youtube_live:siYoutube, vimeo:siVimeo, soundcloud:siSoundcloud, mixcloud:siMixcloud, twitch:siTwitch, kick:siKick, discord:siDiscord,
  bluesky:siBluesky, mastodon:siMastodon, lemmy:siLemmy, github:siGithub,
  gitlab:siGitlab,
  stackexchange:siStackoverflow, instagram:siInstagram, facebook:siFacebook,
  x:siX, tiktok:siTiktok, reddit:siReddit,
};
const icon=icons[provider];
const preserveThemeColor=['github','x','tiktok'].includes(provider);
---
<svg
  class:list={['social-provider-icon', `social-provider-icon--${provider}`]}
  viewBox="0 0 24 24"
  style={icon && !preserveThemeColor ? `color:#${icon.hex}` : undefined}
  aria-hidden="true"
  focusable="false"
>
  {icon ? <path d={icon.path} fill="currentColor" /> : provider === 'trovo' ? <image href="https://astatic.trovocdn.net/cat/favicon.ico" width="24" height="24" preserveAspectRatio="xMidYMid meet" /> : null}
</svg>
