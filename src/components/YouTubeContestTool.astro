---
const apiUrl = (import.meta.env.PUBLIC_SOCIAL_API_URL ?? '').replace(/\/$/u, '');
---

<section class="tool-shell social-youtube-tool" data-youtube-contest data-api-url={apiUrl} aria-labelledby="youtube-import-title">
  <div class="tool-panel-intro">
    <div class="youtube-tool-intro-copy">
      <p class="eyebrow"><span aria-hidden="true">▶</span> Import officiel YouTube</p>
      <h2 id="youtube-import-title">Importer les commentaires YouTube</h2>
      <p>Collez l’URL d’une vidéo ou d’un Short public. Les participants sont dédupliqués avec l’identifiant de leur chaîne, pas seulement leur pseudo.</p>
    </div>
    <ul class="youtube-tool-assurances" aria-label="Garanties du tirage YouTube"><li><span aria-hidden="true">✓</span> API officielle</li><li><span aria-hidden="true">✓</span> Sans connexion</li><li><span aria-hidden="true">✓</span> Tirage Web Crypto</li></ul>
  </div>
  <ol class="youtube-flow" aria-label="Étapes du tirage"><li class="is-current"><span>1</span><div><strong>Analyser</strong><small>Vérifiez la vidéo</small></div></li><li><span>2</span><div><strong>Importer</strong><small>Appliquez vos règles</small></div></li><li><span>3</span><div><strong>Tirer</strong><small>Partagez le résultat</small></div></li></ol>
  <form class="social-import-form" data-contest-form>
    <label class="field">
      <span>URL de la vidéo ou du Short</span>
      <input name="url" type="url" inputmode="url" autocomplete="url" placeholder="https://www.youtube.com/watch?v=…" required />
      <small class="field-hint">Vidéos publiques uniquement. Les commentaires désactivés ne peuvent pas être importés.</small>
    </label>
    <div class="form-row">
      <label class="field"><span>Gagnants</span><input name="winnerCount" type="number" min="1" max="100" value="1" required /></label>
      <label class="field"><span>Suppléants</span><input name="alternateCount" type="number" min="0" max="100" value="0" required /></label>
    </div>
    <label class="field">
      <span>Mot ou expression obligatoire <small>facultatif</small></span>
      <input name="requiredKeyword" type="text" maxlength="120" placeholder="Ex. concours" />
    </label>
    <fieldset class="youtube-rules"><legend>Règles du concours</legend><p>Seuls les critères affichés sont réellement vérifiés pendant l’import.</p><div class="social-rule-grid">
        <label class="option-card"><input name="duplicateEntries" type="checkbox" /><span><strong>Chaque commentaire compte</strong><small>Sinon, une seule chance par chaîne.</small></span></label>
        <label class="option-card"><input name="excludePublicationAuthor" type="checkbox" checked /><span><strong>Exclure l’auteur</strong><small>La chaîne de la vidéo ne participe pas.</small></span></label>
        <label class="option-card is-unavailable" title="Les réponses ne sont pas encore importées intégralement par le MVP."><input type="checkbox" disabled /><span><strong>Inclure les réponses</strong><small>Indisponible pour éviter un import incomplet.</small></span></label>
      </div></fieldset>
    <div class="actions">
      <button class="button button-secondary" type="submit" data-analyze>Analyser la vidéo</button>
      <button class="button button-primary" type="button" data-import disabled>Importer les commentaires</button>
    </div>
  </form>
  <div class="social-import-feedback" data-feedback role="status" aria-live="polite">Le connecteur est en préparation.</div>
  <div class="social-publication-card" data-publication hidden>
    <img data-thumbnail alt="" width="160" height="90" />
    <div><strong data-publication-title></strong><span data-publication-meta></span></div>
  </div>
  <div class="social-draw-panel" data-draw hidden>
    <p data-progress></p>
    <label class="option-card"><input data-public-visibility type="checkbox" /><span><strong>Rendre le résultat partageable</strong><small>Les gagnants et la preuve technique seront visibles à toute personne ayant le lien.</small></span></label>
    <button class="button button-primary" type="button" data-draw-button>Lancer le tirage</button>
    <div class="result-card" data-result hidden></div>
  </div>
</section>

<script>
  const root = document.querySelector('[data-youtube-contest]');
  if (root instanceof HTMLElement) {
    const apiUrl = root.dataset.apiUrl?.replace(/\/$/u, '') ?? '';
    const form = root.querySelector('[data-contest-form]');
    const feedback = root.querySelector('[data-feedback]');
    const publication = root.querySelector('[data-publication]');
    const importButton = root.querySelector('[data-import]');
    const drawPanel = root.querySelector('[data-draw]');
    const progress = root.querySelector('[data-progress]');
    const result = root.querySelector('[data-result]');
    let importId = '';
    const setFeedback = (message: string) => { if (feedback) feedback.textContent = message; };
    const showError = (error: unknown) => setFeedback(error instanceof Error ? error.message : 'Une erreur est survenue.');
    const request = async (path: string, init: RequestInit = {}) => {
      if (!apiUrl) throw new Error('Le connecteur YouTube n’est pas encore activé.');
      const response = await fetch(`${apiUrl}${path}`, { credentials: 'include', headers: { 'content-type': 'application/json', ...(init.headers ?? {}) }, ...init });
      const payload = await response.json() as { error?: string } & Record<string, unknown>;
      if (!response.ok) throw new Error(payload.error ?? 'Le service YouTube est indisponible.');
      return payload;
    };
    if (apiUrl) setFeedback('Prêt à analyser une vidéo ou un Short YouTube.');
    const rules = () => {
      if (!(form instanceof HTMLFormElement)) return {};
      const data = new FormData(form);
      const duplicateEntries = data.get('duplicateEntries') === 'on';
      return { winnerCount: Number(data.get('winnerCount')), alternateCount: Number(data.get('alternateCount')), requiredKeyword: String(data.get('requiredKeyword') ?? '').trim() || undefined, uniqueParticipants: !duplicateEntries, duplicateEntries, includeReplies: false, excludePublicationAuthor: data.get('excludePublicationAuthor') === 'on' };
    };
    const videoUrl = () => form instanceof HTMLFormElement ? String(new FormData(form).get('url') ?? '').trim() : '';
    const updateProgress = async () => {
      if (!importId) return;
      try {
        const payload = await request(`/v1/imports/${importId}`) as { import: { status: string; progress_current: number; progress_total: number | null; participant_count: number; error_message: string | null } };
        const imported = payload.import;
        if (imported.status === 'failed') { setFeedback(imported.error_message ?? 'L’import a échoué.'); return; }
        if (imported.status === 'ready') {
          setFeedback('Import terminé. Vous pouvez lancer le tirage.');
          if (drawPanel instanceof HTMLElement) drawPanel.hidden = false;
          if (progress) progress.textContent = `${imported.participant_count} participant${imported.participant_count > 1 ? 's' : ''} unique${imported.participant_count > 1 ? 's' : ''} éligible${imported.participant_count > 1 ? 's' : ''}.`;
          return;
        }
        if (progress) progress.textContent = `${imported.progress_current}${imported.progress_total ? ` / ${imported.progress_total}` : ''} commentaires analysés…`;
        window.setTimeout(updateProgress, 1600);
      } catch (error) { showError(error); }
    };
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!videoUrl()) { setFeedback('Ajoutez l’URL d’une vidéo YouTube.'); return; }
      setFeedback('Analyse de la vidéo…');
      try {
        const payload = await request('/v1/youtube/publication', { method: 'POST', body: JSON.stringify({ url: videoUrl() }) }) as { publication: { title?: string; authorName?: string; publishedAt?: string; thumbnailUrl?: string } };
        const data = payload.publication;
        const image = root.querySelector('[data-thumbnail]');
        const title = root.querySelector('[data-publication-title]');
        const meta = root.querySelector('[data-publication-meta]');
        if (image instanceof HTMLImageElement) { image.src = data.thumbnailUrl ?? ''; image.hidden = !data.thumbnailUrl; }
        if (title) title.textContent = data.title ?? 'Vidéo YouTube';
        if (meta) meta.textContent = [data.authorName, data.publishedAt ? new Intl.DateTimeFormat('fr-FR').format(new Date(data.publishedAt)) : ''].filter(Boolean).join(' · ');
        if (publication instanceof HTMLElement) publication.hidden = false;
        if (importButton instanceof HTMLButtonElement) importButton.disabled = false;
        setFeedback('Vidéo trouvée. Vérifiez les règles puis importez les commentaires.');
      } catch (error) { showError(error); }
    });
    importButton?.addEventListener('click', async () => {
      setFeedback('Import des commentaires lancé…');
      try {
        const payload = await request('/v1/youtube/imports', { method: 'POST', body: JSON.stringify({ url: videoUrl(), rules: rules() }) }) as { import: { id: string } };
        importId = payload.import.id;
        if (drawPanel instanceof HTMLElement) drawPanel.hidden = false;
        updateProgress();
      } catch (error) { showError(error); }
    });
    root.querySelector('[data-draw-button]')?.addEventListener('click', async () => {
      if (!importId) return;
      setFeedback('Tirage sécurisé en cours…');
      try {
        const visibility = root.querySelector('[data-public-visibility]');
        const payload = await request(`/v1/imports/${importId}/draw`, { method: 'POST', body: JSON.stringify({ publicVisibility: visibility instanceof HTMLInputElement && visibility.checked }) }) as { draw: { publicId: string; publicUrl?: string; winners: Array<{ displayName?: string; username?: string }>; alternates: Array<{ displayName?: string; username?: string }> } };
        const winnerNames = payload.draw.winners.map((winner) => winner.displayName ?? winner.username ?? 'Participant').join(', ');
        const alternateNames = payload.draw.alternates.map((alternate) => alternate.displayName ?? alternate.username ?? 'Participant').join(', ');
        if (result instanceof HTMLElement) {
          result.hidden = false;
          result.replaceChildren();
          const heading = document.createElement('p'); heading.className = 'result-label'; heading.textContent = 'Gagnant(s)';
          const names = document.createElement('p'); names.className = 'result-value'; names.textContent = winnerNames;
          result.append(heading, names);
          if (alternateNames) { const alternates = document.createElement('p'); alternates.textContent = `Suppléant(s) : ${alternateNames}`; result.append(alternates); }
          if (visibility instanceof HTMLInputElement && visibility.checked) {
            const proof = document.createElement('a'); proof.className = 'field-hint'; proof.href = payload.draw.publicUrl ?? '#'; proof.textContent = payload.draw.publicUrl ? 'Ouvrir le résultat partageable' : `Référence partageable : ${payload.draw.publicId}`;
            if (payload.draw.publicUrl) { proof.target = '_blank'; proof.rel = 'noopener'; }
            result.append(proof);
          }
        }
        setFeedback('Tirage terminé.');
      } catch (error) { showError(error); }
    });
  }
</script>
