---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialProviderIcon from './SocialProviderIcon.astro';
import { getSocialProvider, type SocialProviderId } from '../data/social-contests';
import YouTubeContestTool from './YouTubeContestTool.astro';

interface Props { provider: SocialProviderId; }
const { provider: providerId } = Astro.props;
const provider = getSocialProvider(providerId);
const statusClass = `social-status social-status-${provider.status}`;
const pageUrl = new URL(`/tirage-au-sort-${provider.id}`, Astro.site ?? Astro.url.origin).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `Tirage au sort ${provider.name}`,
  url: pageUrl,
  description: provider.description,
  inLanguage: 'fr-FR',
  isPartOf: { '@id': new URL('/#website', Astro.site ?? Astro.url.origin).toString() },
};
const capabilityLabels = [
  ['comments', 'Commentaires'], ['replies', 'Réponses'], ['likes', 'Likes'], ['reposts', 'Reposts'], ['mentions', 'Mentions'], ['followers', 'Abonnés'],
] as const;
---

<BaseLayout title={provider.title} description={provider.description} canonicalPath={`/tirage-au-sort-${provider.id}`}>
  <header class="tool-hero">
    <div class="container tool-heading">
      <a class="breadcrumb" href="/tirage-au-sort-reseaux-sociaux">Tirages réseaux sociaux</a>
      <div class="social-tool-identity"><SocialProviderIcon provider={provider.id} /><p class={statusClass}>{provider.statusLabel}</p></div>
      <h1>Tirage au sort {provider.name}</h1>
      <p>{provider.intro}</p>
    </div>
  </header>
  <div class:list={['container', 'tool-page', { 'tool-page--youtube': providerId === 'youtube' }]}>
    {providerId === 'youtube' ? <YouTubeContestTool /> : <section class="tool-shell social-contest-shell" aria-labelledby="social-setup-title">
      <h2 id="social-setup-title">Connecteur {provider.name}</h2>
      <p>{provider.connection}</p>
      <p class="social-setup-note">Cette page sera activée uniquement lorsque le connecteur officiel et les autorisations nécessaires seront opérationnels.</p>
    </section>}
    {providerId === 'youtube' ? <article class="tool-content prose youtube-information">
      <p class="eyebrow">Un tirage clair, pas une promesse floue</p>
      <h2>Comment réaliser un tirage au sort YouTube ?</h2>
      <ol class="youtube-guide-steps"><li><strong>Collez le lien</strong><span>Utilisez une vidéo ou un Short public dont les commentaires sont activés.</span></li><li><strong>Définissez les règles</strong><span>Choisissez les gagnants, les suppléants, un mot obligatoire et le mode de déduplication.</span></li><li><strong>Importez puis tirez</strong><span>Les commentaires éligibles sont analysés avant une sélection aléatoire via Web Crypto.</span></li></ol>
      <aside class="youtube-limit-note"><strong>Ce qui est réellement vérifié</strong><p>Les commentaires publics, leur auteur, leur contenu et le mot obligatoire éventuel. Les likes individuels, les abonnements à une chaîne et les publications Communauté YouTube ne sont pas vérifiables ici.</p></aside>
      <h2>Un gagnant par chaîne, sauf si vous choisissez autrement</h2>
      <p>Par défaut, plusieurs commentaires publiés par une même chaîne ne créent qu’une seule participation. Vous pouvez activer « Chaque commentaire compte » si votre règlement prévoit plusieurs chances.</p>
    </article> : <article class="tool-content prose">
      <h2>Critères vérifiables</h2>
      <ul class="capability-list">
        {capabilityLabels.map(([capability, label]) => <li class:list={{ 'is-supported': provider.capabilities[capability] }}><span aria-hidden="true">{provider.capabilities[capability] ? '✓' : '–'}</span>{label} {provider.capabilities[capability] ? 'pris en charge selon les autorisations' : 'non vérifiable automatiquement'}</li>)}
      </ul>
      <h2>Limites annoncées clairement</h2>
      <ul>{provider.limitations.map((item) => <li>{item}</li>)}</ul>
      <h2>Transparence du futur tirage</h2>
      <p>Quand le connecteur sera actif, le tirage indiquera précisément les règles appliquées, le nombre de commentaires analysés, les participants uniques et les critères effectivement vérifiés. Aucun résultat ne sera présenté comme certifié sans certification externe.</p>
    </article>}
  </div>
</BaseLayout>
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
