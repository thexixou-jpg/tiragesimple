---
import { getRelatedTools, getTool } from '../data/tools';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from './AdSlot.astro';
import FAQ, { type FAQItem } from './FAQ.astro';
import RelatedTools from './RelatedTools.astro';

interface Props {
  slug: string;
  title?: string;
  description: string;
  intro: string;
  faq?: FAQItem[];
}

const { slug, description, intro, faq = [] } = Astro.props;
const tool = getTool(slug);
const pageTitle = Astro.props.title ?? `${tool.title} gratuite | TirageSimple`;
const url = new URL(`/${slug}`, Astro.site ?? Astro.url.origin).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${url}#application`,
      name: tool.title,
      url,
      description,
      applicationCategory: 'UtilitiesApplication',
      applicationSubCategory: 'Outil de tirage au sort et de choix aléatoire',
      operatingSystem: 'Web',
      browserRequirements: 'JavaScript requis',
      isAccessibleForFree: true,
      inLanguage: 'fr-FR',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      featureList: ['Sans inscription', 'Fonctionnement dans le navigateur', 'Résultat immédiat'],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'TirageSimple', item: new URL('/', Astro.site ?? Astro.url.origin).toString() },
        { '@type': 'ListItem', position: 2, name: tool.title, item: url },
      ],
    },
  ],
};
---

<BaseLayout title={pageTitle} {description} canonicalPath={`/${slug}`}>
  <header class="tool-hero">
    <div class="container tool-heading">
      <a class="breadcrumb" href="/#tous-les-outils">Tous les outils</a>
      <h1>{tool.title}</h1>
      <p>{intro}</p>
    </div>
  </header>
  <div class="container tool-page">
    <section class="tool-shell" aria-label={`Outil ${tool.title}`}>
      <slot name="tool" />
    </section>
    <AdSlot />
    <article class="tool-content prose">
      <slot name="content" />
    </article>
    {faq.length > 0 && <FAQ items={faq} />}
    <RelatedTools tools={getRelatedTools(slug)} />
  </div>
</BaseLayout>
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
