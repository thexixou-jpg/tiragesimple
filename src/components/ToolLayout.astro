---
import { getRelatedTools, getTool } from '../data/tools';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from './AdSlot.astro';
import FAQ, { type FAQItem } from './FAQ.astro';
import RelatedTools from './RelatedTools.astro';

interface Props {
  slug: string;
  title?: string;
  description: string;
  intro: string;
  faq?: FAQItem[];
  showAd?: boolean;
}

const { slug, description, intro, faq = [], showAd = false } = Astro.props;
const tool = getTool(slug);
const pageTitle = Astro.props.title ?? `${tool.title} gratuite | TirageSimple`;
const url = new URL(`/${slug}`, Astro.site ?? Astro.url.origin).toString();
const visualByCategory = {
  roues: '/images/roulette-hero-premium.webp',
  tirages: '/images/draw-hero-premium.webp',
  groupes: '/images/teams-hero-premium.webp',
  hasard: '/images/roulette-hero-premium.webp',
  listes: '/images/draw-hero-premium.webp',
} as const;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${url}#application`,
      name: tool.title,
      url,
      description,
      applicationCategory: 'UtilitiesApplication',
      applicationSubCategory: 'Outil de tirage au sort et de choix aléatoire',
      operatingSystem: 'Web',
      browserRequirements: 'JavaScript requis',
      isAccessibleForFree: true,
      inLanguage: 'fr-FR',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      featureList: ['Sans inscription', 'Fonctionnement dans le navigateur', 'Résultat immédiat'],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'TirageSimple', item: new URL('/', Astro.site ?? Astro.url.origin).toString() },
        { '@type': 'ListItem', position: 2, name: tool.title, item: url },
      ],
    },
  ],
};
---

<BaseLayout title={pageTitle} {description} canonicalPath={`/${slug}`}>
  <header class="tool-hero">
    <div class="container tool-heading tool-heading--visual">
      <div>
        <a class="breadcrumb" href="/#tous-les-outils">Tous les outils</a>
        <h1>{tool.title}</h1>
        <p>{intro}</p>
        <ul class="tool-hero-points" aria-label="Atouts de l’outil">
          <li>Gratuit</li><li>Sans inscription</li><li>Résultat instantané</li>
        </ul>
      </div>
      <div class="tool-hero-art" data-category={tool.category} aria-hidden="true">
        <span class="tool-hero-art__glow"></span>
        <span class="tool-hero-art__ring tool-hero-art__ring--one"></span>
        <span class="tool-hero-art__ring tool-hero-art__ring--two"></span>
        <img class="tool-hero-art__image" src={visualByCategory[tool.category]} width="960" height="960" alt="" decoding="async" />
        <span class="tool-hero-art__label">Prêt à lancer</span>
      </div>
    </div>
  </header>
  <div class="container tool-page">
    <section class="tool-shell" aria-label={`Outil ${tool.title}`}>
      <slot name="tool" />
    </section>
    {showAd && <AdSlot />}
    <article class="tool-content prose">
      <slot name="content" />
    </article>
    {faq.length > 0 && <FAQ items={faq} />}
    <RelatedTools tools={getRelatedTools(slug)} />
  </div>
</BaseLayout>
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
