---
// OAuth starts and returns on the first-party Worker route so the anonymous,
// HttpOnly session cookie remains available throughout the redirect flow.
const apiUrl='/_tiragesimple';
const allowedHosts='pixelfed.social,pixelfed.fr';
---
<section class="tool-shell pixelfed-tool" data-social-contest data-provider="pixelfed" data-api-url={apiUrl} data-allowed-hosts={allowedHosts} aria-labelledby="pixelfed-title">
  <div class="tool-panel-intro"><div><p class="eyebrow">API Pixelfed officielle · OAuth lecture seule</p><h2 id="pixelfed-title">Votre photo, ses interactions, un tirage transparent.</h2><p>Connectez le compte qui a publié la photo puis importez les comptes ayant aimé ou partagé le post public.</p></div></div>
  <form class="social-import-form" data-contest-form>
    <div class="youtube-form-section youtube-form-section--source">
      <div class="youtube-section-heading"><span>01</span><div><strong>Publication du concours</strong><small>Actuellement compatible avec pixelfed.social et pixelfed.fr.</small></div></div>
      <label class="field"><span>URL de la publication Pixelfed</span><input name="url" type="url" inputmode="url" autocomplete="url" placeholder="https://pixelfed.social/p/compte/…" required data-video-url /><small>Copiez l’adresse complète de la photo depuis son instance d’origine.</small></label>
      <section class="pixelfed-account" data-pixelfed-account data-api-url={apiUrl} aria-label="Connexion Pixelfed"><div class="pixelfed-account__mark" aria-hidden="true">P</div><div><strong>Compte organisateur</strong><p data-pixelfed-notice>Vérification de la connexion…</p><p data-pixelfed-connected hidden><span data-pixelfed-identity></span> <button class="text-button" type="button" data-pixelfed-disconnect>Déconnecter</button></p></div><a class="button button-primary" data-pixelfed-connect href="#" aria-disabled="true">Connecter Pixelfed</a></section>
      <aside class="youtube-preview pf-preview" data-preview data-state="idle" aria-live="polite"><div class="youtube-preview__empty"><span aria-hidden="true">P</span><div><strong>Aperçu de la publication</strong><small>La photo, la légende, l’auteur et la date apparaîtront ici.</small></div></div><div class="pf-post" data-publication hidden><img data-thumbnail hidden alt="" /><div><p class="eyebrow">Publication sélectionnée</p><p data-publication-title></p><small data-publication-meta></small></div></div></aside>
    </div>
    <div class="youtube-form-section"><div class="youtube-section-heading"><span>02</span><div><strong>Règles du concours</strong><small>Un seul type d’interaction par tirage.</small></div></div><label class="field"><span>Participation via</span><select name="interaction"><option value="likes">Un like sur la publication</option><option value="reposts">Un partage de la publication</option></select></label><div class="form-row"><label class="field"><span>Gagnants</span><input name="winnerCount" type="number" min="1" max="100" value="1" required /></label><label class="field"><span>Suppléants</span><input name="alternateCount" type="number" min="0" max="100" value="0" required /></label></div><label class="field"><span>Comptes à exclure <small>facultatif</small></span><input name="excludedUsers" type="text" maxlength="2500" placeholder="compte, compte@instance" /><small>Pseudos ou identités ActivityPub, séparés par une virgule.</small></label><label class="option-card"><input name="excludePublicationAuthor" type="checkbox" checked /><span><strong>Exclure l’auteur</strong><small>Le compte qui a publié la photo ne participe pas.</small></span></label></div>
    <div class="actions"><button class="button button-secondary" type="submit">Analyser la publication</button><button class="button button-primary" type="button" data-import disabled>Importer les participants</button></div>
  </form>
  <div class="social-import-feedback" data-feedback role="status" aria-live="polite">Vérification du connecteur…</div><div class="social-draw-panel" data-draw hidden><p data-progress></p><section class="social-rules-summary" aria-label="Règles appliquées"><h3>Votre liste, vos règles</h3><p>Règles figées pour cet import.</p><ul data-rules-summary></ul></section><label class="option-card"><input data-public-visibility type="checkbox" /><span><strong>Créer un lien de résultat public</strong><small>Les gagnants et règles sont partagés, pas la liste complète.</small></span></label><button class="button button-primary" type="button" data-draw-button disabled>Lancer le tirage</button><div class="result-card" data-result hidden></div></div>
</section>
<script>import '../scripts/social-contest';import '../scripts/pixelfed-account';</script>
<style>
.pixelfed-tool{--color-primary:#6366f1}.pixelfed-tool .youtube-form-section{border-color:color-mix(in srgb,#6366f1 28%,var(--color-border))}.pixelfed-tool .youtube-form-section--source{background:linear-gradient(135deg,color-mix(in srgb,#6366f1 10%,var(--color-surface)),color-mix(in srgb,#e1306c 6%,var(--color-surface)))}.pixelfed-tool .youtube-section-heading>span,.pf-preview .youtube-preview__empty>span,.pixelfed-account__mark{background:linear-gradient(135deg,#6366f1,#e1306c);color:#fff}.pixelfed-account{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:1rem;margin:1rem 0;padding:1rem;border:1px solid color-mix(in srgb,#6366f1 28%,var(--color-border));border-radius:1rem;background:color-mix(in srgb,var(--color-surface) 92%,transparent)}.pixelfed-account__mark{display:grid;place-items:center;width:2.75rem;height:2.75rem;border-radius:.85rem;font-weight:900}.pixelfed-account p{margin:.25rem 0 0;color:var(--color-text-muted);font-size:.88rem}.pixelfed-account [aria-disabled="true"]{opacity:.5;pointer-events:none}.pf-preview{margin-top:1rem}.pf-preview::after{background:none}.pf-post{display:grid;grid-template-columns:minmax(160px,260px) 1fr}.pf-post img{width:100%;height:100%;max-height:260px;object-fit:cover}.pf-post>div{padding:1.25rem;align-self:center}.pf-post [data-publication-title]{white-space:pre-wrap;line-height:1.55}@media(max-width:700px){.pixelfed-account{grid-template-columns:auto 1fr}.pixelfed-account .button{grid-column:1/-1}.pf-post{grid-template-columns:1fr}.pf-post img{max-height:240px}}
</style>
