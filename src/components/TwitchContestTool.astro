---
const configuredApi = (import.meta.env.PUBLIC_SOCIAL_API_URL ?? '').replace(/\/$/u, '');
const apiUrl = configuredApi || '/_tiragesimple';
const oauthStart = `${configuredApi || 'https://tiragesimple.fr/_tiragesimple'}/v1/twitch/oauth/start`;
---
<section class="tool-shell twitch-tool" aria-labelledby="twitch-tool-title">
  <div class="tool-panel-intro"><div><p class="eyebrow">OAuth Twitch officiel</p><h2 id="twitch-tool-title">Tirer au sort parmi les personnes présentes</h2><p>Le diffuseur ou un modérateur autorise uniquement la lecture de la liste actuelle du chat.</p></div></div>
  <section class="twitch-account" data-twitch-account data-api-url={apiUrl} aria-label="Connexion Twitch"><div class="twitch-account__icon" aria-hidden="true">T</div><div><strong>Compte Twitch</strong><p data-twitch-notice>Vérification de la configuration…</p><p data-twitch-connected hidden><span data-twitch-identity></span> <button class="text-button" type="button" data-twitch-disconnect>Déconnecter</button></p></div><a class="button button-primary" data-twitch-connect href={oauthStart}>Connecter Twitch</a></section>
  <div data-social-contest data-provider="twitch" data-api-url={apiUrl}>
    <form class="social-import-form" data-contest-form>
      <div class="youtube-form-section youtube-form-section--source"><div class="youtube-section-heading"><span>01</span><div><strong>Chaîne à analyser</strong><small>Vous devez être le diffuseur ou un modérateur de cette chaîne.</small></div></div><div class="youtube-source-grid"><label class="field"><span>Login ou URL Twitch</span><input name="url" type="text" autocomplete="off" placeholder="twitch ou https://twitch.tv/twitch" required data-video-url /><small>La chaîne et l’autorisation du compte connecté sont vérifiées.</small></label><aside class="youtube-preview twitch-preview" data-preview data-state="idle" aria-live="polite"><div class="youtube-preview__empty"><span class="twitch-glyph" aria-hidden="true">T</span><div><strong>Aperçu de la chaîne</strong><small>Le nom et l’avatar apparaîtront ici.</small></div></div><div class="youtube-preview__content" data-publication hidden><img data-thumbnail alt="" width="300" height="300" /><div><span class="youtube-preview__label">Chat accessible</span><strong data-publication-title></strong><span data-publication-meta></span></div></div></aside></div></div>
      <div class="youtube-form-section"><div class="youtube-section-heading"><span>02</span><div><strong>Paramètres du tirage</strong><small>Une seule chance par identifiant Twitch.</small></div></div><div class="form-row"><label class="field"><span>Gagnants</span><input name="winnerCount" type="number" min="1" max="100" value="1" required /></label><label class="field"><span>Suppléants</span><input name="alternateCount" type="number" min="0" max="100" value="0" required /></label></div><label class="option-card twitch-owner-rule"><input name="excludePublicationAuthor" type="checkbox" checked /><span><strong>Exclure le diffuseur</strong><small>La chaîne organisatrice ne participe pas.</small></span></label><label class="field social-exclusions"><span>Comptes à exclure <small>facultatif</small></span><input name="excludedUsers" type="text" maxlength="2500" placeholder="login1, 12345678" /><small>Logins Twitch ou identifiants numériques, séparés par une virgule.</small></label></div>
      <div class="twitch-disclosure"><strong>Éligibilité réellement vérifiée</strong><ul><li>✓ compte présent dans la liste du chat</li><li>✓ identité Twitch stable et unique</li><li>? message envoyé, follow et abonnement non vérifiés</li></ul></div>
      <div class="actions"><button class="button button-secondary" type="submit">Vérifier la chaîne</button><button class="button button-primary" type="button" data-import disabled>Importer les personnes présentes</button></div>
    </form>
    <div class="social-import-feedback" data-feedback role="status" aria-live="polite">Vérification du connecteur…</div>
    <div class="social-draw-panel" data-draw hidden><p data-progress></p><section class="social-rules-summary" aria-label="Règles appliquées"><h3>Liste Twitch importée</h3><p>La liste et les règles sont figées pour ce tirage.</p><ul data-rules-summary></ul></section><label class="option-card"><input data-public-visibility type="checkbox" /><span><strong>Créer un lien public</strong><small>Les gagnants et les preuves sont partagés, jamais la liste complète des personnes présentes.</small></span></label><button class="button button-primary" type="button" data-draw-button disabled>Lancer le tirage</button><div class="result-card" data-result hidden></div></div>
  </div>
</section>
<script>import '../scripts/social-contest'; import '../scripts/twitch-account';</script>
<style>
  .twitch-tool{--color-primary:#9146ff}.twitch-tool>.tool-panel-intro{background:linear-gradient(125deg,#9146ff1c,var(--color-surface))}.twitch-account{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:1rem;margin:1.25rem;padding:1rem;border:1px solid #9146ff55;border-radius:1rem;background:#9146ff0c}.twitch-account p{margin:.2rem 0;color:var(--color-text-muted)}.twitch-account__icon,.twitch-glyph{display:grid;place-items:center;width:2.7rem;aspect-ratio:1;border-radius:.7rem;background:#9146ff;color:#fff;font-weight:900}.text-button{border:0;background:none;color:var(--color-primary);text-decoration:underline;cursor:pointer}.twitch-preview{background:linear-gradient(135deg,#25173d,#171828)}.twitch-preview img{aspect-ratio:1;object-fit:cover}.twitch-owner-rule{margin-top:1rem}.twitch-disclosure{margin:0 1.25rem 1.25rem;padding:1rem 1.1rem;border:1px solid #9146ff44;border-radius:1rem;background:#9146ff0a}.twitch-disclosure ul{margin:.55rem 0 0;padding-left:1.2rem;color:var(--color-text-muted)}@media(max-width:650px){.twitch-account{grid-template-columns:auto 1fr}.twitch-account .button{grid-column:1/-1;width:100%}}
</style>
