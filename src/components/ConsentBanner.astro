<section class="consent-banner" data-consent-banner role="dialog" aria-modal="true" aria-labelledby="consent-title" hidden>
  <div class="consent-banner__content">
    <div>
      <p class="eyebrow">Votre confidentialité</p>
      <h2 id="consent-title">Gérez vos cookies</h2>
      <p>Nous utilisons uniquement le stockage nécessaire au fonctionnement du site. Vous pouvez autoriser séparément les mesures d’audience et la publicité.</p>
      <a href="/cookies">En savoir plus</a>
    </div>
    <div class="consent-banner__actions">
      <button class="button button-secondary" type="button" data-consent-reject>Refuser</button>
      <button class="button button-secondary" type="button" data-consent-customize>Personnaliser</button>
      <button class="button button-primary" type="button" data-consent-accept>Accepter</button>
    </div>
  </div>
  <div class="consent-options" data-consent-options hidden>
    <label><input type="checkbox" checked disabled /> Fonctionnement essentiel <small>Toujours actif</small></label>
    <label><input type="checkbox" data-consent-analytics /> Mesure d’audience <small>Facultatif</small></label>
    <label><input type="checkbox" data-consent-advertising /> Publicité personnalisée <small>Facultatif</small></label>
    <button class="button button-primary" type="button" data-consent-save>Enregistrer mes choix</button>
  </div>
</section>
