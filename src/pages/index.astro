---
import ToolGrid from '../components/ToolGrid.astro';
import { categoryOrder } from '../data/navigation';
import { categoryLabels, tools } from '../data/tools';
import BaseLayout from '../layouts/BaseLayout.astro';
const popularTools = tools.filter((tool) => tool.popular);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': 'https://tiragesimple.fr/#website', name: 'TirageSimple', alternateName: 'Tirage Simple', url: 'https://tiragesimple.fr/', inLanguage: 'fr-FR', description: 'Outils de tirage au sort, roues et choix aléatoires gratuits.', publisher: { '@id': 'https://tiragesimple.fr/#publisher' } },
    { '@type': 'Person', '@id': 'https://tiragesimple.fr/#publisher', name: 'Bertrand Da Silva', url: 'https://tiragesimple.fr/mentions-legales' },
    { '@type': 'ItemList', name: 'Outils de tirage au sort et choix aléatoire', itemListElement: tools.map((tool, position) => ({ '@type': 'ListItem', position: position + 1, name: tool.title, url: `https://tiragesimple.fr/${tool.slug}` })) },
  ],
};
---
<BaseLayout
  title="TirageSimple – Tirage au sort et outils aléatoires gratuits"
  description="Tirez un nom, faites tourner une roue ou créez vos équipes gratuitement. Des outils rapides, sans inscription et respectueux de vos données."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-content">
        <span class="eyebrow"><span aria-hidden="true">✦</span> Simple · Rapide · Privé</span>
        <h1>Le hasard <span class="gradient-text">en un clic.</span></h1>
        <p class="hero-copy">Une roue, un tirage, des équipes : laissez le hasard décider avec des outils gratuits, clairs et instantanés.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/roue-aleatoire">Faire tourner la roue <span aria-hidden="true">→</span></a>
          <a class="button button-secondary" href="#tous-les-outils">Explorer les outils</a>
        </div>
        <ul class="trust-list" aria-label="Avantages">
          <li>Sans inscription</li><li>Données dans votre navigateur</li><li>Résultat immédiat</li>
        </ul>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="hero-orbit hero-orbit-one"></div><div class="hero-orbit hero-orbit-two"></div>
        <img class="hero-wheel-image" src="/images/roulette-hero-premium.webp" width="877" height="960" alt="" decoding="async" fetchpriority="high" />
        <div class="hero-list-preview"><span class="field-kicker">Participants</span><strong>6 choix prêts</strong><div><i></i><i></i><i></i><i></i><i></i><i></i></div></div>
        <div class="hero-float-card hero-float-card-top"><span>✦</span> Le hasard est prêt</div>
        <div class="hero-float-card hero-float-card-bottom"><span class="live-dot"></span> 100 % côté navigateur</div>
      </div>
    </div>
  </section>
  <section class="section use-cases-section" aria-labelledby="use-cases-title">
    <div class="container">
      <div class="section-heading section-heading--split"><div>
        <p class="eyebrow">Choisissez votre moment</p>
        <h2 id="use-cases-title">Un outil adapté à chaque décision.</h2>
      </div><p>Trois façons simples de commencer, avec des résultats immédiats et sans compte.</p></div>
      <div class="use-case-grid">
        <a class="use-case-card use-case-card--wheel" href="/roue-aleatoire">
          <div><span class="use-case-card__number">01</span><h3>Faire tourner une roue</h3><p>Pour choisir rapidement parmi des idées, prénoms ou activités.</p><span class="tool-link">Ouvrir la roue <span aria-hidden="true">→</span></span></div>
          <img src="/images/roulette-hero-premium.webp" width="877" height="960" alt="" loading="lazy" decoding="async" />
        </a>
        <a class="use-case-card use-case-card--draw" href="/tirage-au-sort">
          <div><span class="use-case-card__number">02</span><h3>Tirer un gagnant</h3><p>Ajoutez une liste et obtenez un choix aléatoire impartial.</p><span class="tool-link">Lancer un tirage <span aria-hidden="true">→</span></span></div>
          <img src="/images/draw-hero-premium.webp" width="960" height="960" alt="" loading="lazy" decoding="async" />
        </a>
        <a class="use-case-card use-case-card--teams" href="/generateur-equipes">
          <div><span class="use-case-card__number">03</span><h3>Créer des équipes</h3><p>Répartissez les participants en groupes équilibrés en un clic.</p><span class="tool-link">Former des équipes <span aria-hidden="true">→</span></span></div>
          <img src="/images/teams-hero-premium.webp" width="960" height="960" alt="" loading="lazy" decoding="async" />
        </a>
      </div>
    </div>
  </section>
  <section class="section social-entry-section" aria-labelledby="social-entry-title">
    <div class="container">
      <div class="social-entry">
        <div class="social-entry-copy">
          <p class="eyebrow">Concours &amp; réseaux sociaux</p>
          <h2 id="social-entry-title">Tirez vos gagnants à partir de vrais commentaires.</h2>
          <p>Un espace distinct pour les concours sur les réseaux sociaux : import officiel, règles explicites et tirage transparent. YouTube est disponible pour les vidéos et les Shorts publics.</p>
          <div class="social-entry-actions">
            <a class="button button-primary" href="/tirage-au-sort-youtube">Essayer le tirage YouTube <span aria-hidden="true">→</span></a>
            <a class="button button-secondary" href="/tirage-au-sort-reseaux-sociaux">Voir les plateformes</a>
          </div>
          <ul class="social-entry-points" aria-label="Fonctionnalités du tirage YouTube">
            <li>Commentaires officiels</li><li>Participants dédupliqués</li><li>Résultat partageable</li>
          </ul>
        </div>
        <img class="social-entry-visual" src="/images/social-contests-hero.webp" width="960" height="960" alt="Illustration d’un tirage au sort parmi des interactions sur les réseaux sociaux" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>
  <section class="section section-surface" aria-labelledby="popular-title">
    <div class="container">
      <div class="section-heading"><div>
        <h2 id="popular-title">Outils populaires</h2>
        <p>Les raccourcis les plus utiles pour laisser le hasard décider.</p>
      </div></div>
      <ToolGrid tools={popularTools} />
    </div>
  </section>
  <section class="section workflow-section" aria-labelledby="workflow-title">
    <div class="container workflow-grid">
      <div class="workflow-visual" aria-hidden="true">
        <div class="workflow-board"><div class="workflow-board-head"><span>Votre tirage</span><i></i></div><div class="workflow-winner"><small>Résultat</small><strong>Chloé</strong><span>✓ Tirage effectué</span></div><div class="workflow-board-list"><span><i></i>Alice</span><span><i></i>Benoît</span><span class="is-winner"><i></i>Chloé</span><span><i></i>David</span></div></div>
      </div>
      <div class="workflow-copy">
        <span class="eyebrow">Un seul réflexe</span>
        <h2 id="workflow-title">Décidez vite.<br /><span class="gradient-text">Restez impartial.</span></h2>
        <p>Ajoutez vos choix, lancez le tirage et partagez le résultat. Tout se passe directement dans votre navigateur.</p>
        <ol class="workflow-steps">
          <li><span>01</span><div><strong>Ajoutez votre liste</strong><small>Collez des noms ou créez vos choix en quelques secondes.</small></div></li>
          <li><span>02</span><div><strong>Lancez l’outil</strong><small>Notre moteur aléatoire utilise Web Crypto lorsque disponible.</small></div></li>
          <li><span>03</span><div><strong>Gardez ou partagez</strong><small>Votre résultat reste visible et prêt à être copié.</small></div></li>
        </ol>
      </div>
    </div>
  </section>
  <section class="section" id="tous-les-outils" aria-labelledby="all-tools-title">
    <div class="container">
      <div class="section-heading"><div>
        <h2 id="all-tools-title">Tous les outils</h2>
        <p>Choisissez une catégorie, puis ouvrez l’outil dont vous avez besoin.</p>
      </div></div>
      <nav class="category-pills" aria-label="Catégories d’outils">
        {categoryOrder.map((category) => <a href={`#category-${category}`}>{categoryLabels[category]}</a>)}
      </nav>
      {categoryOrder.map((category) => (
        <section class="category-block catalog-category" aria-labelledby={`category-${category}`}>
          <div class="catalog-category-heading"><h3 class="category-title" id={`category-${category}`}>{categoryLabels[category]}</h3><span>{tools.filter((tool) => tool.category === category).length} outils</span></div>
          <ToolGrid tools={tools.filter((tool) => tool.category === category)} compact />
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} is:inline />
